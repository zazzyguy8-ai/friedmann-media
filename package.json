{
  "name": "ai-blocker",
  "version": "1.0.0",
  "description": "AI Blocker — give users full control over AI on the web.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.mjs && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.281",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
